<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cloud_sync_now_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF42664D"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/cloud_sync_now_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:maxLines="3"
        android:text="@string/cloud_sync_widget_now_preview"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cloud_sync_now_undo"
        style="@style/DesktopWidgetActionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textSize="12sp" />
</LinearLayout>
