<?xml version="1.0" encoding="utf-8"?>
<!-- App-module layout for desktop widgets: playable mini games, music visualizer, reader,
     screen-time visualizations and the combined cloud-sync module. Most content is rendered as a
     single bitmap (game board / spectrum / chart) so the panel stays cheap to update. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_apps_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#263238"
    android:padding="0dp">

    <ImageView
        android:id="@+id/widget_apps_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_apps_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_apps_foreground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/widget_apps_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/widget_apps_board_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/widget_apps_board"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <!-- RemoteViews cannot receive arbitrary swipe callbacks. These invisible edge zones
                 preserve direct board play without showing directional controls. -->
            <LinearLayout
                android:id="@+id/widget_apps_2048_gesture_zones"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_apps_2048_hit_up"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/widget_apps_2048_hit_left"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent" />
                    <TextView
                        android:id="@+id/widget_apps_2048_hit_right"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_apps_2048_hit_down"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </FrameLayout>

        <!-- Direction controls for playable games (2048, snake, tetris, spider). -->
        <LinearLayout
            android:id="@+id/widget_apps_dpad"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_apps_btn_up"
                style="@style/DesktopWidgetActionText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_apps_btn_left"
                style="@style/DesktopWidgetActionText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_apps_btn_right"
                style="@style/DesktopWidgetActionText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_apps_btn_down"
                style="@style/DesktopWidgetActionText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Column selector row for Spider solitaire (10 columns). -->
        <LinearLayout
            android:id="@+id/widget_apps_columns"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView android:id="@+id/widget_apps_column_1" style="@style/DesktopWidgetMealAction" />
            <TextView android:id="@+id/widget_apps_column_2" style="@style/DesktopWidgetMealAction" />
            <TextView android:id="@+id/widget_apps_column_3" style="@style/DesktopWidgetMealAction" />
            <TextView android:id="@+id/widget_apps_column_4" style="@style/DesktopWidgetMealAction" />
            <TextView android:id="@+id/widget_apps_column_5" style="@style/DesktopWidgetMealAction" />
            <TextView android:id="@+id/widget_apps_column_6" style="@style/DesktopWidgetMealAction" />
            <TextView android:id="@+id/widget_apps_column_7" style="@style/DesktopWidgetMealAction" />
            <TextView android:id="@+id/widget_apps_column_8" style="@style/DesktopWidgetMealAction" />
            <TextView android:id="@+id/widget_apps_column_9" style="@style/DesktopWidgetMealAction" />
            <TextView android:id="@+id/widget_apps_column_10" style="@style/DesktopWidgetMealAction" />
        </LinearLayout>

        <!-- Generic action row: new game / deal / flag mode / pass / open app. -->
        <LinearLayout
            android:id="@+id/widget_apps_actions"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_apps_action_1"
                style="@style/DesktopWidgetActionText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_apps_action_2"
                style="@style/DesktopWidgetActionText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Tap grid for minesweeper / go (9x9 = 81 cells). -->
        <GridLayout
            android:id="@+id/widget_apps_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="9"
            android:rowCount="9"
            android:visibility="gone">
            <TextView android:id="@+id/widget_apps_cell_1" style="@style/DesktopWidgetCell" />
