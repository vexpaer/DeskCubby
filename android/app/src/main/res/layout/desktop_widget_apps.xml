            <TextView android:id="@+id/widget_apps_cell_81" style="@style/DesktopWidgetCell" />
        </GridLayout>

        <!-- Cloud-sync combined module: status lines plus buttons. -->
        <LinearLayout
            android:id="@+id/widget_apps_cloud_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/widget_apps_cloud_status_1" style="@style/DesktopWidgetStatusRow" />
            <TextView android:id="@+id/widget_apps_cloud_status_2" style="@style/DesktopWidgetStatusRow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_apps_cloud_actions"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_apps_cloud_now"
                style="@style/DesktopWidgetActionText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_apps_cloud_undo"
                style="@style/DesktopWidgetActionText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_apps_cloud_upload"
                style="@style/DesktopWidgetActionText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_apps_cloud_download"
                style="@style/DesktopWidgetActionText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
