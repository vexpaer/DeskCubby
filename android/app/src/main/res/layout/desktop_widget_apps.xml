            <TextView android:id="@+id/widget_apps_cell_8" style="@style/DesktopWidgetCell" />
            <TextView android:id="@+id/widget_apps_cell_9" style="@style/DesktopWidgetCell" />
            <TextView android:id="@+id/widget_apps_cell_10" style="@style/DesktopWidgetCell" />
            <TextView android:id="@+id/widget_apps_cell_11" style="@style/DesktopWidgetCell" />
