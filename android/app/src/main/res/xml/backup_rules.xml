<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Android system backup must not clone a device identity or private statistics.
         Statistics now share the main Room database, and Android backup cannot exclude tables,
         so the whole database is excluded. DeskCubby v31 JSON/cloud sync is the explicit backup
         path for supported structured data. -->
    <exclude
        domain="database"
        path="deskcubby.db" />
    <exclude
        domain="database"
        path="deskcubby.db-wal" />
    <exclude
        domain="database"
        path="deskcubby.db-shm" />
    <exclude
        domain="database"
        path="deskcubby.db-journal" />
    <exclude
        domain="file"
        path="reader/" />
    <exclude
        domain="file"
        path="engagement/" />
    <exclude
        domain="file"
        path="statistics/" />
    <exclude
        domain="file"
        path="usage-statistics.json" />
    <exclude
        domain="file"
        path="usage-statistics.json.bak" />
    <exclude
        domain="file"
        path="usage-statistics.json.new" />
    <exclude
        domain="file"
        path="usage-device-histories/" />
    <exclude
        domain="file"
        path="datastore/usage_device_identity.preferences_pb" />
    <exclude
        domain="file"
        path="step-statistics.json" />
    <exclude
        domain="file"
        path="step-statistics.json.bak" />
    <exclude
        domain="file"
        path="step-statistics.json.new" />
    <exclude
        domain="sharedpref"
        path="desktop_widget_instances.xml" />
    <exclude
        domain="sharedpref"
        path="desktop_widget_thought_drafts.xml" />
    <exclude
        domain="sharedpref"
        path="cloud_sync_runtime.xml" />
    <exclude
        domain="sharedpref"
        path="cloud_sync_manual_queue.xml" />
    <!-- The settings DataStore holds API keys, S3 access/secret/session credentials and cloud
         passwords. It must never be carried into an Android Auto Backup / device transfer; the
         explicit DeskCubby backup (sanitized JSON / record sync) is the intended settings path. -->
    <exclude
        domain="file"
        path="datastore/deskcubby_settings.preferences_pb" />
    <!-- Legacy encrypted API-key store (obsolete but kept for migration reads). -->
    <exclude
        domain="sharedpref"
        path="deskcubby_ai_secrets.xml" />
</full-backup-content>
