<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Room contains device-private usage and Health Connect aggregates. Android cannot
             exclude individual tables, so explicit DeskCubby v31 JSON remains the backup path. -->
        <exclude
            domain="database"
            path="deskcubby.db" />
        <exclude
            domain="database"
            path="deskcubby.db-wal" />
        <exclude
            domain="database"
            path="deskcubby.db-shm" />
        <exclude
            domain="database"
            path="deskcubby.db-journal" />
        <exclude
            domain="file"
            path="reader/" />
        <exclude
            domain="file"
            path="engagement/" />
        <exclude
            domain="file"
            path="statistics/" />
        <exclude
            domain="file"
            path="usage-statistics.json" />
        <exclude
            domain="file"
            path="usage-statistics.json.bak" />
        <exclude
            domain="file"
            path="usage-statistics.json.new" />
        <exclude
            domain="file"
            path="usage-device-histories/" />
        <exclude
            domain="file"
            path="datastore/usage_device_identity.preferences_pb" />
        <exclude
            domain="file"
            path="step-statistics.json" />
        <exclude
            domain="file"
            path="step-statistics.json.bak" />
        <exclude
            domain="file"
            path="step-statistics.json.new" />
        <exclude
            domain="sharedpref"
            path="desktop_widget_instances.xml" />
        <exclude
            domain="sharedpref"
            path="desktop_widget_thought_drafts.xml" />
        <exclude
            domain="sharedpref"
            path="cloud_sync_runtime.xml" />
        <exclude
            domain="sharedpref"
            path="cloud_sync_manual_queue.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="deskcubby.db" />
        <exclude
            domain="database"
            path="deskcubby.db-wal" />
        <exclude
            domain="database"
            path="deskcubby.db-shm" />
        <exclude
            domain="database"
            path="deskcubby.db-journal" />
        <exclude
            domain="file"
            path="reader/" />
        <exclude
            domain="file"
            path="engagement/" />
        <exclude
            domain="file"
            path="statistics/" />
        <exclude
            domain="file"
            path="usage-statistics.json" />
        <exclude
            domain="file"
            path="usage-statistics.json.bak" />
        <exclude
            domain="file"
            path="usage-statistics.json.new" />
        <exclude
            domain="file"
            path="usage-device-histories/" />
        <exclude
            domain="file"
            path="datastore/usage_device_identity.preferences_pb" />
        <exclude
            domain="file"
            path="step-statistics.json" />
        <exclude
            domain="file"
            path="step-statistics.json.bak" />
        <exclude
            domain="file"
            path="step-statistics.json.new" />
        <exclude
            domain="sharedpref"
            path="desktop_widget_instances.xml" />
        <exclude
            domain="sharedpref"
            path="desktop_widget_thought_drafts.xml" />
        <exclude
            domain="sharedpref"
            path="cloud_sync_runtime.xml" />
        <exclude
            domain="sharedpref"
            path="cloud_sync_manual_queue.xml" />
    </device-transfer>
</data-extraction-rules>
